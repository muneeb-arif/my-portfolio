# Portfolio Owner Configuration
# REACT_APP_PORTFOLIO_OWNER_EMAIL=you@example.com

# CRA → Next API (required for production)
REACT_APP_USE_API_SERVICE=true
REACT_APP_ENABLE_HYBRID_MODE=true
REACT_APP_API_URL=https://your-api.vercel.app/api

# JWT for API (generate a strong random string; do not commit real values)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Vercel Postgres — use in api/.env (server only; never add to CRA env on Vercel)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Vercel Blob — use in api/.env only
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxx

# Optional: MySQL source for scripts/migrate-mysql-to-vercel-postgres.js
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=secret
# MYSQL_DATABASE=portfolio

# Optional: Supabase Storage migration (scripts/migrate-supabase-storage-to-vercel-blob.js)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# EmailJS (public in CRA)
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_TEMPLATE_ID=
REACT_APP_EMAILJS_USER_ID=

# API tuning
NODE_ENV=development
BCRYPT_ROUNDS=12
API_RATE_LIMIT=100

# Portfolio owner user id resolution on server (contact queries GET, etc.)
# PORTFOLIO_OWNER_EMAIL=you@example.com
