# =============================================================================
# Unified Next.js app (UI + /api). Copy to .env.local for local dev.
# =============================================================================

# --- Browser (NEXT_PUBLIC_*) ---
# Optional: override API base when UI and API are not same-origin (default: /api on this host)
# NEXT_PUBLIC_API_URL=https://your-deployment.vercel.app/api

NEXT_PUBLIC_USE_API_SERVICE=true
NEXT_PUBLIC_ENABLE_HYBRID_MODE=true

# EmailJS (public)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_USER_ID=

# Legacy CRA names still read as fallback in some files:
# REACT_APP_API_URL=
# REACT_APP_EMAILJS_SERVICE_ID=

NEXT_PUBLIC_PORTFOLIO_OWNER_EMAIL=
NEXT_PUBLIC_UPDATE_ENDPOINT=

# --- Server only (never expose to the browser) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxx
# BLOB_PUT_ACCESS=private

SUPABASE_URL=
SUPABASE_ANON_KEY=

NODE_ENV=development
BCRYPT_ROUNDS=12
API_RATE_LIMIT=100

# Optional: scripts
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=portfolio
