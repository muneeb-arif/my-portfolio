  "scripts": {
    "prebuild": "node scripts/generate-api-router.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "legacy:update-meta": "node scripts/update-meta-tags.js",
    "legacy:build-cra": "npm run legacy:update-meta && npx react-scripts build",
    "legacy:start-cra": "react-scripts start",
    "create-packages": "zip -r build.zip build/ && npm run create-minimal-update",
    "create-optimized-packages": "node scripts/create-optimized-packages.js",
    "optimize-images": "node scripts/optimize-images.js",
    "quick-optimize": "node scripts/quick-optimize-images.js",
    "replace-domain-images": "node scripts/replace-domain-images.js",
    "create-minimal-update": "mkdir -p minimal-update && cp build/index.html minimal-update/ && cp -r build/static minimal-update/ && cp build/update-endpoint.php minimal-update/ 2>/dev/null || true && cd minimal-update && zip -r ../minimal-update.zip . && cd .. && rm -rf minimal-update && echo '✅ Created packages:' && ls -lh build.zip minimal-update.zip",
    "upload-backup": "node scripts/upload-build-backup.js",
    "serve-build": "serve -s build -l 3000",
    "create-update": "node scripts/create-theme-update.js",
    "release": "npm run create-update",
    "upload-package": "node scripts/upload-update-package.js",
    "list-clients": "node scripts/upload-update-package.js --list-clients",
    "list-updates": "node scripts/upload-update-package.js --list-updates",
    "migrate:mysql-to-pg": "node scripts/migrate-mysql-to-vercel-postgres.js",
    "compare:mysql-pg": "node scripts/compare-mysql-postgres-migration.js",
    "migrate:supabase-to-blob": "node scripts/migrate-supabase-storage-to-vercel-blob.js",
    "remap:urls": "node scripts/remap-urls-from-map.js"
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
  }
}
